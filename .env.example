# Optional overrides for the local Docker Compose stack. These values are for
# development only; use deployment-managed secrets in production.
POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone_dev_only
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=local-development-secret-change-me-32chars
JWT_EXPIRES_IN=15m
VITE_API_URL=http://localhost:3000
