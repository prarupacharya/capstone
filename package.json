{
  "name": "capstone",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "db:down": "docker compose down",
    "db:up": "docker compose up -d postgres",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings=0 && node scripts/run-workspaces.mjs lint",
    "sonar": "node scripts/sonar.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.base.json && node scripts/run-workspaces.mjs typecheck",
    "test": "node --test test/repository.test.mjs test/cd-config.test.mjs && node scripts/run-workspaces.mjs test"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  }
}
